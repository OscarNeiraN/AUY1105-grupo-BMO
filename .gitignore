# Terraform state files
*.tfstate
*.tfstate.*

# Terraform plan files
*.tfplan
tfplan.binary
tfplan.json

# Terraform variable files with sensitive data
*.tfvars
*.tfvars.json

# Non-sensitive lab variables
!terraform/terraform.tfvars

# Terraform working directories
.terraform/

# Terraform override files
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# Terraform crash logs
crash.log
crash.*.log

# Local CLI credentials and private keys
.terraformrc
terraform.rc
*.pem
*.key
*.p12
*.pfx

# Local backup and temporary files
*.bak
*.tmp
*.swp
*~
